# Copy to .env and fill in. Never commit .env.

# TallyPrime XML server (F1 Help > Settings > Connectivity > Client/Server: "Both", port 9000)
TALLY_URL=http://127.0.0.1:9000
TALLY_COMPANY=Your Company Name As In Tally

# Gateway listens on loopback only; cloudflared publishes it.
BIND=127.0.0.1
PORT=8787

# Authentication. "cloudflare" in production. "dev" only for testing on this PC.
AUTH_MODE=cloudflare
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# Zero Trust > Access > Applications > (your app) > Overview > Application Audience (AUD) Tag
CF_AUD=paste-the-aud-tag-here
DEV_USER=you@example.com

# Who can do what. Comma-separated emails, or *@yourdomain.com
VIEWERS=accountant@example.com,partner@example.com
POSTERS=you@example.com

# Entry rules for mobile posting
ALLOWED_VOUCHER_TYPES=Receipt,Payment,Contra,Journal
BACKDATE_DAYS=7
MAX_RANGE_DAYS=92

# Seconds to cache read results (Tally serves one request at a time)
CACHE_TTL=60
# AUDIT_LOG=C:\TallyWeb\logs\audit.jsonl
